{
  "name": "eu.ugent.icoodim",
  "version": "1.0.0",
  "description": "The archived ICOOPMA-EuroDIM 2022 conference and Doctoral School site.",
  "productName": "ICOOPMA-EuroDIM 2022",
  "author": "Ghent University",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^24"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src/**/*.{ts,js,mjs,cjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "type-check": "vue-tsc --noEmit -p tsconfig.vue-tsc.json",
    "dev": "quasar dev",
    "build": "quasar build -m pwa",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "evan-kit": "file:./evan-kit",
    "pinia": "^4.0.3",
    "quasar": "^2.28.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.42",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@material-design-icons/svg": "^0.14.15",
    "@quasar/app-vite": "^3.8.1",
    "@types/node": "^24",
    "@types/sanitize-html": "^2.16.1",
    "@types/web": "^0.0.354",
    "@vue/compiler-dom": "^3.5.42",
    "@vue/devtools-api": "^8.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "workbox-build": "^7.0.0"
  }
}
